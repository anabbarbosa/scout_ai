# Copy to .env and fill in. Never commit .env.

# Database — PostgreSQL from docker/compose.yml (then run `scout db-setup`).
# For a quick throwaway run without Docker: DATABASE_URL=sqlite:///scout_ai.db
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5434/scout_ai

# LLM — uses your Claude subscription, not an API key.
# Locally: run `claude login` once. Unattended runs (CI, scheduler): run `claude setup-token`
# and put the token here. Do NOT set ANTHROPIC_API_KEY; it would override the subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# HubSpot Private App token
HUBSPOT_TOKEN=

# Only the machine that runs `scout fetch` needs HUBSPOT_TOKEN and the Marketing CSV
# exports in data/raw/ (ignored by Git). Everyone else only needs DATABASE_URL.
# Competitor collectors (guide Step 3): identify the bot and add a team contact, e.g.
# ScoutAI/0.1 (competitor monitoring bot; marketing-ops@example.com)
COLLECTOR_USER_AGENT=ScoutAI/0.1 (competitor monitoring bot)
COLLECTOR_DELAY_SECONDS=5

# Synthetic demo dataset (guide Step 5): change the seed to generate a different dataset.
DEMO_SEED=42
