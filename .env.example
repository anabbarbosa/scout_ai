# Copy to .env and fill in. Never commit .env.

# Database — SQLite for local dev, PostgreSQL in production
# e.g. postgresql+psycopg://user:password@localhost:5432/scout_ai
DATABASE_URL=sqlite:///scout_ai.db

# LLM — uses your Claude subscription, not an API key.
# Locally: run `claude login` once. Unattended runs (CI, scheduler): run `claude setup-token`
# and put the token here. Do NOT set ANTHROPIC_API_KEY; it would override the subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# HubSpot Private App token
HUBSPOT_TOKEN=

# ClickUp
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

# Power BI (Entra ID app / service principal) — optional in the MVP
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
